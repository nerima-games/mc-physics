{
  "name": "@nerima-games/mc-physics",
  "version": "0.1.7",
  "type": "module",
  "description": "Pure voxel physics primitives for the nerima-games Minecraft-clone rebuild: Euler integration, AABB collision, DDA raycasts, environment effects, entity collisions, projectile sweeps, primed TNT fuse progression, and bounded explosion planning. No external physics engine.",
  "homepage": "https://github.com/nerima-games/mc-physics#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-physics.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-physics/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "physics",
    "aabb",
    "voxel-dda"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --noEmit --pretty false && tsc -p tsconfig.test.json --pretty false",
    "build": "corepack pnpm build:types && corepack pnpm build:js",
    "build:types": "tsc -p tsconfig.build.json --pretty false",
    "build:js": "esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2024 --external:@nerima-games/mc-kernel --external:effect --sourcemap=external --outfile=dist/index.js",
    "prepublishOnly": "corepack pnpm verify",
    "lint": "oxlint --deny-warnings src scripts test",
    "lint:fix": "oxlint --fix src scripts test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "corepack pnpm build && node scripts/benchmark.mjs",
    "verify:package": "node scripts/package-smoke.mjs",
    "verify": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm test:coverage && corepack pnpm build && corepack pnpm verify:package"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.4.0",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.11"
  }
}
