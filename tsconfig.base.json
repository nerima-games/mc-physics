{
  // Shared compiler options for every tsconfig in this repository.
  // Copied from @nerima-games/mc-kernel; keep the two in sync.
  // Strictness policy: `strict: true` PLUS every additional strictness flag
  // spelled out explicitly, so that a future TypeScript release changing a
  // default cannot silently weaken this repository.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // mc-physics is platform-agnostic pure computation: no DOM, no WebWorker,
    // no Node globals. The simulation must be replayable in a headless Node run
    // bit-for-bit, so it must not be able to reach a platform API at all.
    "lib": ["ES2024"],
    "types": [],

    "allowJs": false,
    "checkJs": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictBuiltinIteratorReturn": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    // Public declarations must be derivable from each source file's explicit
    // annotations, so an implementation-only inference change cannot silently
    // change the package API.
    "isolatedDeclarations": true,
    // A type-only import must say so. The emitted JavaScript then follows from
    // the import statement alone.
    "verbatimModuleSyntax": true,
    // Nothing that needs a runtime transform to have meaning: no enum, no
    // namespace, no parameter property. The domain is types and pure
    // computation already, so this pins the property rather than requesting a
    // change.
    "erasableSyntaxOnly": true,
    // A side-effect import that resolves to nothing is an error, not a no-op.
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "skipLibCheck": true,

    "newLine": "lf",
    "stripInternal": true,

    // Check configurations are no-emit; tsconfig.build.json overrides this
    // for the declaration-only package build.
    "noEmit": true,
  }
}
