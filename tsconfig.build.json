{
  // Shipped source only. `types: []` (inherited) is deliberate: if a Node type
  // ever leaks into domain code this project fails, which is what keeps
  // mc-physics usable from browser, worker and server repos alike. Check-only:
  // tsconfig.release.json is the sole emitting configuration.
  "extends": "./tsconfig.base.json",
  "include": ["src/index.ts", "src/domain/**/*.ts"],
  "exclude": [
    "node_modules",
    "coverage",
    "dist",
    "test/**",
    "scripts/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
